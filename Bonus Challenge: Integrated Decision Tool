revenue = float(input("What's the revenue? "))
cost = float(input("What's the cost? "))
category = input("What's the product category? ")
category = category.strip().lower()

if category == "electronics" or category == "gadget" or category == "tech":
	category_name = "High Margin"
	recommendation = "Reinvest"
elif category == "clothing" or category == "apparel":
	category_name = "Medium Margin"
	recommendation = "Maintain and optimize"
elif category == "food" or category == "grocery":
	category_name = "Low Margin"
	recommendation = "Review pricing"
else:
	category_name = "Uncategorized"
	recommendation = "Review product strategy"

print("Category:", category_name)

if revenue > cost:
	profit = revenue - cost
	print("Profit:", profit)
	print("Suggestion:", recommendation)
else:
	loss = cost - revenue
	print("Not profitable. Loss:", loss)
