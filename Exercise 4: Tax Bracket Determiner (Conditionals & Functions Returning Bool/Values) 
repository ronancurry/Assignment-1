def get_tax_bracket(income):
	if income < 0:
		return "Invalid income"
	if income < 50000:
		return "Low (10%)"
	if income < 100000:
		return "Medium (20%)"
	return "High (30%)"


income = float(input("What's your annual income? "))
bracket = get_tax_bracket(income)

if bracket == "Invalid income":
	print("Your bracket:", bracket)
elif bracket == "Low (10%)":
	estimated_tax = income * 0.10
	print("Your bracket:", bracket)
	print("Estimated tax:", estimated_tax)
elif bracket == "Medium (20%)":
	estimated_tax = income * 0.20
	print("Your bracket:", bracket)
	print("Estimated tax:", estimated_tax)
else:
	estimated_tax = income * 0.30
	print("Your bracket:", bracket)
	print("Estimated tax:", estimated_tax)
