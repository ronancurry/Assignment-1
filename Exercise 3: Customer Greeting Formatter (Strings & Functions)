def format_greeting(name, title="Customer"):
	name = name.strip()  # Remove whitespace from the beginning and end.

	if not name:
		return "Hello, Valued Customer!"

	name = name.title()  # Capitalize the first letter of each name part.
	first_name = name.split()[0]  # Split the full name and keep the first part.
	title = title.lower().title()  # Normalize the title's capitalization.

	return f"Hello, {first_name} ({title})!"


full_name = input("What's your full name? ")
print(format_greeting(full_name))
